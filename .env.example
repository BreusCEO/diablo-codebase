# Copy to .env.local for development. On Vercel, set these in Project → Settings → Environment Variables.

# Signs the session cookie (HS256). Required in production; at least 32 characters.
# Generate: openssl rand -base64 32
# In development it may be left empty: an ephemeral secret is used and sessions end on restart.
AUTH_SECRET=

# Google OAuth web client (Google Cloud Console → APIs & Services → Credentials).
# Leave both empty to run without Google: the button shows as unavailable and the demo still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin used to build the OAuth redirect URI (<APP_ORIGIN>/api/auth/google/callback).
# Optional: defaults to the origin of the incoming request.
APP_ORIGIN=http://localhost:3123
